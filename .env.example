# Example environment variables (DO NOT use real secrets here)
# Use Supabase Connection Pooler locally if your network does not support IPv6.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_app?sslmode=require
AUTH_SECRET=change-this-secret-before-production
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
YOUTUBE_API_KEY=your-google-api-key

# LiveKit credential encryption key (generate once and keep it backed up securely).
# Use the same key on every server instance. Never commit the real key.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# VOICE_PROVIDER_ENCRYPTION_KEY=

# MinIO Object Storage (optional — falls back to local disk when disabled)
# MINIO_ENABLED=true
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_USE_SSL=false
# MINIO_BUCKET=serene-panda
# MINIO_PUBLIC_URL=/minio
#LIVEKIT_URL=wss://safarihost-5amab49c.livekit.cloud
#LIVEKIT_API_KEY=your-livekit-api-key
#LIVEKIT_API_SECRET=your-livekit-api-secret

# Wallet agent portal: set a private random URL-safe key (at least 32 characters).
# Share the resulting /agent/<key> link only with wallet agents.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# WALLET_AGENT_PORTAL_KEY=

# Hosting-owner portal: the private path is not a substitute for the separate login.
# Keep actual values only in the private runtime environment, never in source control.
# HOSTING_OWNER_PORTAL_KEY=
# HOSTING_OWNER_USERNAME=
# HOSTING_OWNER_PASSWORD_HASH=

# Site-owner member bootstrap: configure a unique username and scrypt hash before startup.
# Generate a hash with the project's scrypt format; never store the plaintext password here.
# SITE_OWNER_USERNAME=
# SITE_OWNER_PASSWORD_HASH=

# ============================================================
# إعدادات الأداء والتوسع (مضافة بعد فحص الأداء)
# ============================================================

# قاعدة البيانات - حد اتصالات لكل instance؛ اترك مساحة لاتصالات الإدارة والخدمات الأخرى.
# اضبط DB_POOL_MAX وفق حد قاعدة البيانات وعدد نسخ التطبيق التي تعمل بالتوازي.
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# Redis — إلزامي في الإنتاج لضمان عمل Rate Limiting عند التوسع الأفقي
# REDIS_REQUIRED=true يمنع تشغيل الـ server بدون Redis في بيئة production
REDIS_REQUIRED=false